# Ignore compiled files
*.o
*.out
*.exe
__pycache__/
*.pyc

# Ignore editor/IDE files
.vscode/
.idea/
*.log
*.swp
*.swo
*.bak

# Ignore system files
.DS_Store
Thumbs.db

# Python virtual environment
venv/
.env

# Ignore pytest caches
.pytest_cache/

# Ignore data caches and downloaded datasets
data_cache/

# Ignore temporary uploads for inference
temp_uploads/

# Ignore saved PyTorch models
*.pth
*.pt
# EXCEPT the best model which is needed for inference!
!best_model.pth

# Ignore generated training reports and logs
training_history.csv
classification_report.txt
